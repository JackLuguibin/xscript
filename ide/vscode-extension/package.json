{
  "name": "xscript-vscode",
  "displayName": "%xscript.displayName%",
  "description": "%xscript.description%",
  "version": "0.2.0",
  "publisher": "xscript",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/__init__.py",
    "workspaceContains:**/build.as",
    "onView:xscript.devices",
    "onDebugResolve:xscript",
    "onDebugDynamicConfigurations:xscript"
  ],
  "contributes": {
    "commands": [
      {
        "command": "xscript.connect",
        "title": "%xscript.command.connect%",
        "category": "XScript"
      },
      {
        "command": "xscript.selectDevice",
        "title": "%xscript.command.selectDevice%",
        "category": "XScript",
        "icon": "$(device-mobile)"
      },
      {
        "command": "xscript.manageDevices",
        "title": "%xscript.command.manageDevices%",
        "category": "XScript"
      },
      {
        "command": "xscript.scanDevices",
        "title": "%xscript.command.scanDevices%",
        "category": "XScript",
        "icon": "$(search)"
      },
      {
        "command": "xscript.addDevice",
        "title": "%xscript.command.addDevice%",
        "category": "XScript",
        "icon": "$(add)"
      },
      {
        "command": "xscript.editDevice",
        "title": "%xscript.command.editDevice%",
        "category": "XScript",
        "icon": "$(edit)"
      },
      {
        "command": "xscript.removeDevice",
        "title": "%xscript.command.removeDevice%",
        "category": "XScript",
        "icon": "$(trash)"
      },
      {
        "command": "xscript.useDevice",
        "title": "%xscript.command.useDevice%",
        "category": "XScript"
      },
      {
        "command": "xscript.status",
        "title": "%xscript.command.status%",
        "category": "XScript"
      },
      {
        "command": "xscript.newProject",
        "title": "%xscript.command.newProject%",
        "category": "XScript",
        "icon": "$(new-folder)"
      },
      {
        "command": "xscript.syncManage",
        "title": "%xscript.command.syncManage%",
        "category": "XScript",
        "icon": "$(sync)"
      },
      {
        "command": "xscript.upload",
        "title": "%xscript.command.upload%",
        "category": "XScript"
      },
      {
        "command": "xscript.pullProject",
        "title": "%xscript.command.pullProject%",
        "category": "XScript",
        "icon": "$(cloud-download)"
      },
      {
        "command": "xscript.editSyncIgnore",
        "title": "%xscript.command.editSyncIgnore%",
        "category": "XScript"
      },
      {
        "command": "xscript.run",
        "title": "%xscript.command.run%",
        "category": "XScript",
        "icon": "$(play)"
      },
      {
        "command": "xscript.runOnDevice",
        "title": "%xscript.command.runOnDevice%",
        "category": "XScript",
        "icon": "$(play)"
      },
      {
        "command": "xscript.runRemote",
        "title": "%xscript.command.runRemote%",
        "category": "XScript",
        "icon": "$(play)"
      },
      {
        "command": "xscript.debug",
        "title": "%xscript.command.debug%",
        "category": "XScript",
        "icon": "$(debug-alt)"
      },
      {
        "command": "xscript.stop",
        "title": "%xscript.command.stop%",
        "category": "XScript",
        "icon": "$(debug-stop)"
      },
      {
        "command": "xscript.logs",
        "title": "%xscript.command.logs%",
        "category": "XScript"
      },
      {
        "command": "xscript.eval",
        "title": "%xscript.command.eval%",
        "category": "XScript"
      },
      {
        "command": "xscript.screenshot",
        "title": "%xscript.command.screenshot%",
        "category": "XScript"
      },
      {
        "command": "xscript.openTools",
        "title": "%xscript.command.openTools%",
        "category": "XScript"
      },
      {
        "command": "xscript.openScreen",
        "title": "%xscript.command.openScreen%",
        "category": "XScript"
      },
      {
        "command": "xscript.adbTerminal",
        "title": "%xscript.command.adbTerminal%",
        "category": "XScript"
      },
      {
        "command": "xscript.configureStubs",
        "title": "%xscript.command.configureStubs%",
        "category": "XScript"
      },
      {
        "command": "xscript.refreshView",
        "title": "%xscript.command.refreshView%",
        "category": "XScript",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "xscript.useDevice",
          "when": "false",
          "group": "hidden"
        },
        {
          "command": "xscript.runRemote",
          "when": "false",
          "group": "hidden"
        },
        {
          "command": "xscript.editDevice",
          "when": "true",
          "group": "x"
        },
        {
          "command": "xscript.removeDevice",
          "when": "true",
          "group": "x"
        }
      ],
      "editor/title": [
        {
          "command": "xscript.selectDevice",
          "when": "resourceLangId == python && xscript.isProject",
          "group": "navigation@1"
        },
        {
          "command": "xscript.run",
          "when": "resourceLangId == python && xscript.isProject && !xscript.running",
          "group": "navigation@2"
        },
        {
          "command": "xscript.stop",
          "when": "resourceLangId == python && xscript.isProject && xscript.running",
          "group": "navigation@2"
        },
        {
          "command": "xscript.debug",
          "when": "resourceLangId == python && xscript.isProject && !xscript.running",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "xscript.selectDevice",
          "when": "view == workbench.explorer.fileView && xscript.isProject",
          "group": "navigation@1"
        },
        {
          "command": "xscript.run",
          "when": "view == workbench.explorer.fileView && xscript.isProject && !xscript.running",
          "group": "navigation@2"
        },
        {
          "command": "xscript.stop",
          "when": "view == workbench.explorer.fileView && xscript.isProject && xscript.running",
          "group": "navigation@2"
        },
        {
          "command": "xscript.debug",
          "when": "view == workbench.explorer.fileView && xscript.isProject && !xscript.running",
          "group": "navigation@3"
        },
        {
          "command": "xscript.scanDevices",
          "when": "view == xscript.devices",
          "group": "navigation@1"
        },
        {
          "command": "xscript.addDevice",
          "when": "view == xscript.devices",
          "group": "navigation@2"
        },
        {
          "command": "xscript.refreshView",
          "when": "view == xscript.devices",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "xscript.runOnDevice",
          "when": "view == xscript.devices && viewItem == xscript.device.idle",
          "group": "inline@1"
        },
        {
          "command": "xscript.stop",
          "when": "view == xscript.devices && viewItem == xscript.device.running",
          "group": "inline@1"
        },
        {
          "command": "xscript.editDevice",
          "when": "view == xscript.devices && viewItem =~ /^xscript\\.device\\./",
          "group": "xscript@1"
        },
        {
          "command": "xscript.removeDevice",
          "when": "view == xscript.devices && viewItem =~ /^xscript\\.device\\./",
          "group": "xscript@2"
        },
        {
          "command": "xscript.runRemote",
          "when": "view == xscript.devices && viewItem == xscript.project",
          "group": "inline@1"
        },
        {
          "command": "xscript.pullProject",
          "when": "view == xscript.devices && viewItem == xscript.project",
          "group": "inline@2"
        }
      ],
      "explorer/context": [
        {
          "command": "xscript.run",
          "when": "explorerResourceIsFolder",
          "group": "xscript"
        },
        {
          "command": "xscript.upload",
          "when": "explorerResourceIsFolder",
          "group": "xscript"
        },
        {
          "command": "xscript.debug",
          "when": "explorerResourceIsFolder",
          "group": "xscript"
        },
        {
          "command": "xscript.editSyncIgnore",
          "when": "explorerResourceIsFolder",
          "group": "xscript"
        }
      ],
      "editor/context": [
        {
          "command": "xscript.eval",
          "when": "editorHasSelection && resourceLangId == python",
          "group": "xscript"
        }
      ]
    },
    "keybindings": [
      {
        "command": "xscript.run",
        "key": "ctrl+shift+r",
        "when": "editorTextFocus && resourceLangId == python && xscript.isProject"
      },
      {
        "command": "xscript.run",
        "key": "f6",
        "when": "editorLangId == python"
      },
      {
        "command": "xscript.stop",
        "key": "shift+f6",
        "when": "editorLangId == python"
      },
      {
        "command": "xscript.debug",
        "key": "alt+f6",
        "when": "editorLangId == python"
      }
    ],
    "breakpoints": [
      {
        "language": "python"
      }
    ],
    "debuggers": [
      {
        "type": "xscript",
        "label": "XScript (device)",
        "languages": [
          "python"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "projectRoot": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Local project folder (contains __init__.py). Default: the project of the active file."
              },
              "project": {
                "type": "string",
                "description": "Project name on the device. Default: the folder name."
              },
              "device": {
                "type": "string",
                "description": "Device address; default is the xscript.device setting."
              },
              "upload": {
                "type": "boolean",
                "default": true,
                "description": "Upload the project to the device before debugging."
              },
              "justMyCode": {
                "type": "boolean",
                "default": true,
                "description": "Only step through the project's own code."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "xscript",
            "request": "launch",
            "name": "XScript: Debug on device",
            "projectRoot": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "XScript: Debug on device",
            "description": "Upload the project and debug it on the connected device",
            "body": {
              "type": "xscript",
              "request": "launch",
              "name": "XScript: Debug on device",
              "projectRoot": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%xscript.config.title%",
      "properties": {
        "xscript.device": {
          "type": "string",
          "default": "127.0.0.1:9860",
          "description": "%xscript.config.device%"
        },
        "xscript.logPollMs": {
          "type": "number",
          "default": 1000,
          "minimum": 200,
          "description": "%xscript.config.logPollMs%"
        },
        "xscript.evalTimeoutMs": {
          "type": "number",
          "default": 8000,
          "minimum": 200,
          "maximum": 15000,
          "description": "%xscript.config.evalTimeoutMs%"
        },
        "xscript.adbPath": {
          "type": "string",
          "default": "",
          "description": "%xscript.config.adbPath%"
        },
        "xscript.scanLan": {
          "type": "boolean",
          "default": true,
          "description": "%xscript.config.scanLan%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xscript",
          "title": "%xscript.container.title%",
          "icon": "media/xscript.svg"
        }
      ]
    },
    "views": {
      "xscript": [
        {
          "id": "xscript.devices",
          "name": "%xscript.view.name%"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p . && node scripts/copy-stubs.js",
    "watch": "tsc -watch -p .",
    "test": "node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "host-test": "bash scripts/cursor-host-test.sh",
    "package": "npx --yes @vscode/vsce@3.6.2 package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "typescript": "5.9.3"
  }
}
