      "type": "any",
      "default": 0
    },
    {
      "name": "low",
      "type": "any",
      "default": 0
    },
    {
      "name": "high",
      "type": "any",
      "default": 0
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "any"
    }
  ],
  "py": {
    "stmt": "min(max({a}, {low}), {high})"
  },
  "dsl": {
    "alias": "clamp"
  },
  "since": "0.2.6",
  "availability": "ok"
