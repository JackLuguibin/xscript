# 公网域名，DNS 已解析到这台服务器（Caddy 会自动申请 HTTPS 证书）
XSCRIPT_DOMAIN=cloud.example.com

# 首次启动时创建的管理员。启动后在后台「账号与令牌」改密码并开启两步验证；
# 之后改这里不会影响已有账号。
XSCRIPT_ADMIN_USER=admin
XSCRIPT_ADMIN_PASSWORD=请改成至少8位的强密码

# slim = 云控 / 卡密 / 小程序；full = 额外支持在后台打包 APK（镜像约 2.5 GB）
XSCRIPT_IMAGE_TARGET=slim

# 网页登录有效期（小时）
XSCRIPT_SESSION_HOURS=12
